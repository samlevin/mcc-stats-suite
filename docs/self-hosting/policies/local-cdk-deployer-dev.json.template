{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssumeDevCdkBootstrapRoles",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": [
        "arn:aws:iam::DEV_ACCOUNT_ID:role/cdk-mcclocal1-deploy-role-DEV_ACCOUNT_ID-AWS_REGION",
        "arn:aws:iam::DEV_ACCOUNT_ID:role/cdk-mcclocal1-file-publishing-role-DEV_ACCOUNT_ID-AWS_REGION",
        "arn:aws:iam::DEV_ACCOUNT_ID:role/cdk-mcclocal1-image-publishing-role-DEV_ACCOUNT_ID-AWS_REGION",
        "arn:aws:iam::DEV_ACCOUNT_ID:role/cdk-mcclocal1-lookup-role-DEV_ACCOUNT_ID-AWS_REGION"
      ]
    },
    {
      "Sid": "ReadCdkBootstrapMetadata",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStacks",
        "cloudformation:GetTemplate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadLocalBootstrapVersion",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:AWS_REGION:DEV_ACCOUNT_ID:parameter/cdk-bootstrap/mcclocal1/version"
    },
    {
      "Sid": "ReadEphemeralMatchToCsvLogs",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogStreams",
        "logs:FilterLogEvents",
        "logs:GetLogEvents",
        "logs:GetLogGroupFields",
        "logs:GetQueryResults",
        "logs:StartLiveTail",
        "logs:StartQuery"
      ],
      "Resource": [
        "arn:aws:logs:AWS_REGION:DEV_ACCOUNT_ID:log-group:/aws/lambda/match-to-csv-e-*",
        "arn:aws:logs:AWS_REGION:DEV_ACCOUNT_ID:log-group:/aws/lambda/match-to-csv-e-*:*",
        "arn:aws:logs:AWS_REGION:DEV_ACCOUNT_ID:log-group:/aws/vendedlogs/states/match-to-csv-e-*",
        "arn:aws:logs:AWS_REGION:DEV_ACCOUNT_ID:log-group:/aws/vendedlogs/states/match-to-csv-e-*:*"
      ]
    },
    {
      "Sid": "ListLogGroupsAndStopQueries",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:StopQuery"
      ],
      "Resource": "*"
    }
  ]
}
