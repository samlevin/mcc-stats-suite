{
  "$schema": "../node_modules/@agenticool/core/src/policy.schema.json",
  "description": "Repository binding and labels for the agent workflows. agenticool-agents generates the Claude Code and Codex definitions and syncs the board files from it; model, effort, and the implementation effort rubric come from the @agenticool/core defaults.",
  "binding": {
    "label": "MCC",
    "project": {
      "owner": "samlevin",
      "ownerType": "user",
      "number": 1,
      "name": "MCC delivery"
    },
    "docs": {
      "triage": "ISSUE_TRIAGE.md",
      "workflow": "WORKFLOW.md",
      "guides": ["WORKFLOW.md", "TESTING.md"]
    },
    "features": {
      "infrastructure": true,
      "releasePlease": true,
      "browserMcp": true
    },
    "infrastructure": {
      "accountChecks": ["scripts/cdk-app.mjs", "packages/cdk-config"]
    }
  },
  "labels": {
    "extra": [
      {
        "name": "area: infrastructure",
        "color": "d4c5f9",
        "description": "OpenTofu foundation and persistent shared resources"
      },
      {
        "name": "autorelease: pending",
        "color": "ededed",
        "description": "Managed by Release Please; never apply by hand"
      },
      {
        "name": "package: admin",
        "color": "5319e7",
        "description": "Directly affects the @mcc/admin NPM package"
      },
      {
        "name": "package: cdk-config",
        "color": "5319e7",
        "description": "Directly affects the @mcc/cdk-config NPM package"
      },
      {
        "name": "package: contracts",
        "color": "5319e7",
        "description": "Directly affects the @mcc/contracts NPM package"
      },
      {
        "name": "package: data-pipeline",
        "color": "5319e7",
        "description": "Directly affects the @mcc/data-pipeline NPM package"
      },
      {
        "name": "package: match-to-csv",
        "color": "5319e7",
        "description": "Directly affects the @mcc/match-to-csv NPM package"
      },
      {
        "name": "package: ocr-quality",
        "color": "5319e7",
        "description": "Directly affects the @mcc/ocr-quality NPM package"
      },
      {
        "name": "package: player",
        "color": "5319e7",
        "description": "Directly affects the @mcc/player NPM package"
      },
      {
        "name": "package: recipients",
        "color": "5319e7",
        "description": "Directly affects the @mcc/recipients NPM package"
      },
      {
        "name": "package: roster",
        "color": "5319e7",
        "description": "Directly affects the @mcc/roster NPM package"
      },
      {
        "name": "risk: deployment",
        "color": "e99695",
        "description": "May affect deployment, rollback, or persistent infrastructure"
      }
    ]
  }
}
