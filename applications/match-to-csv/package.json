{
  "name": "@mcc/match-to-csv",
  "private": true,
  "version": "3.4.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "CDK_VALIDATION=false node --import tsx --test --experimental-test-coverage --test-coverage-include=\"cdk/**\" --test-coverage-include=\"src/**\" --test-coverage-lines=80 --test-coverage-branches=65 --test-coverage-functions=60 test/*.test.ts",
    "verify:bundle": "node scripts/verify-bundles.mjs",
    "cdk:synth": "cdk synth",
    "cdk:diff": "cdk diff",
    "cdk:deploy": "cdk deploy",
    "cdk:destroy": "cdk destroy",
    "ci:synth": "cdk synth -c environment=dev -c ephemeral=ci",
    "ci:test": "CDK_VALIDATION=false node --import tsx --test --test-concurrency=2 --experimental-test-coverage --test-coverage-include=\"cdk/**\" --test-coverage-include=\"src/**\" --test-coverage-lines=80 --test-coverage-branches=65 --test-coverage-functions=60 test/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.992.0",
    "@aws-sdk/client-s3": "^3.992.0",
    "@aws-sdk/client-sesv2": "^3.992.0",
    "@aws-sdk/client-ssm": "^3.992.0",
    "@aws-sdk/client-textract": "^3.992.0",
    "@mcc/cdk-config": "2.0.0",
    "@mcc/contracts": "1.3.1",
    "@mcc/recipients": "1.1.3",
    "@mcc/roster": "1.1.4",
    "mailparser": "^3.9.3",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/mailparser": "^3.4.6",
    "aws-cdk-lib": "2.262.2",
    "constructs": "^10.5.0",
    "esbuild": "0.28.1",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15"
  }
}
