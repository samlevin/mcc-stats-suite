{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "cdk:synth": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "cdk:diff": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "cdk:deploy": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    }
  }
}
