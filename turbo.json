{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "cdk:synth": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "cdk:diff": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "cdk:deploy": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "ci:synth": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "verify:bundle": {
      "dependsOn": ["ci:synth"],
      "cache": false
    },
    "ci:test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@mcc/cdk-config#ci:test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "//#test:scripts": {
      "dependsOn": [
        "@mcc/contracts#build",
        "@mcc/cdk-config#build",
        "@mcc/roster#build",
        "@mcc/recipients#build"
      ],
      "inputs": [
        "scripts/**",
        ".github/**",
        ".terrateam/**",
        "infrastructure/**",
        "applications/**",
        "packages/**",
        "docs/self-hosting/policies/**",
        "*.json",
        "*.mjs",
        ".*",
        "!.git",
        "!**/node_modules/**",
        "!**/.turbo/**",
        "!**/dist/**",
        "!**/cdk.out/**",
        "!**/coverage/**",
        "!**/*.tsbuildinfo",
        "!**/.terraform/**"
      ],
      "outputs": []
    }
  },
  "cacheDir": ".turbo/cache",
  "globalDependencies": [
    "tsconfig.base.json",
    ".tool-versions",
    "scripts/cli.cjs"
  ],
  "globalEnv": ["MCC_BUILD_ENVIRONMENT"],
  "globalPassThroughEnv": [
    "TURBO_API",
    "TURBO_TOKEN",
    "TURBO_TEAM",
    "TS_NODE_TRANSPILE_ONLY"
  ]
}
