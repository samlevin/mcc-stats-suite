#!/usr/bin/env bash
# Copy to .envrc, edit, then run: direnv allow
# `npm run app:*` reads AWS_PROFILE, and scripts/cdk-app.mjs takes the expected
# account from the profile's sso_account_id. Export AWS_REGION too only when
# the profile sets no Region. Each OpenTofu root under infrastructure/ has its
# own self-contained .envrc.
export AWS_PROFILE="mcc-dev"
