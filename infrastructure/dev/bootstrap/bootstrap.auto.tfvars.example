# Optional. The profile, Region, and GitHub inputs come from this directory's
# ignored .envrc; see .envrc.example.
#
# Set create_terrateam_role to true only if Terrateam applies the foundation.
# Set create_cdk_deploy_role to false only when this root bootstraps a locally
# managed, disposable Sandbox account rather than the shared dev account.
create_terrateam_role  = false
create_cdk_deploy_role = true
