#!/usr/bin/env bash
# Copy to .envrc in this directory, edit the first section, then run:
#   direnv allow
# This file is self-contained: tofu init, plan, and apply work from this
# directory with nothing else set. Every exported name follows one rule:
#   AWS_*             read by the AWS CLI and SDKs (AWS_PROFILE, and AWS_REGION
#                     only when the profile sets no Region)
#   TF_VAR_<name>     sets the OpenTofu input <name> and nothing else
#   TF_CLI_ARGS_init  passes the backend bucket and Region to tofu init

# Edit these.
export AWS_PROFILE="mcc-prod-admin"
# The email domain and alias are read below from the SSM parameters the
# applied foundation owns. Only for the first apply that creates a parameter,
# such as in a new environment, uncomment its line with the lowercase domain
# verified for SES or the lowercase alias before the @, then remove it after
# the apply. Never commit either.
# email_domain_override="REPLACE_WITH_VERIFIED_DOMAIN"
# email_alias_override="REPLACE_WITH_EMAIL_ALIAS"
# OWNER@OWNER_ID/REPOSITORY@REPOSITORY_ID for immutable GitHub OIDC subjects,
# otherwise OWNER/REPOSITORY. Get the IDs with:
#   gh api repos/OWNER/REPOSITORY --jq '.owner.id, .id'
export TF_VAR_github_oidc_subject_repository="OWNER@OWNER_ID/REPOSITORY@REPOSITORY_ID"

# Derived from the values above; do not edit. `aws configure get` reads the
# local AWS config and makes no network call. When the profile has no
# sso_account_id, set account_id="<12-digit ID>" (not exported) above.
account_id="${account_id:-$(aws configure get sso_account_id || true)}"
region="${AWS_REGION:-$(aws configure get region || true)}"
if [[ -z "$account_id" || -z "$region" ]]; then
  echo "Set sso_account_id and region on profile $AWS_PROFILE, or set account_id and AWS_REGION in this file" >&2
fi
export TF_VAR_aws_region="$region"
export TF_CLI_ARGS_init="-backend-config=bucket=mcc-stats-suite-tofu-state-${account_id}-${region} -backend-config=region=${region}"

# The email domain and alias come from the SSM parameters the applied
# foundation owns, so a local plan sees the applied values and never changes
# them. These are the only derived values that need a network call and a
# signed-in profile. The values are never printed.
email_domain_parameter="/mcc/prod/match-to-csv/email-domain"
if [[ -n "${email_domain_override:-}" ]]; then
  export TF_VAR_email_domain="$email_domain_override"
elif email_domain="$(aws ssm get-parameter --name "$email_domain_parameter" --region "$region" \
  --query Parameter.Value --output text 2>/dev/null)"; then
  export TF_VAR_email_domain="$email_domain"
else
  echo "Cannot read $email_domain_parameter with profile $AWS_PROFILE; TF_VAR_email_domain is unset. Run aws sso login, or set email_domain_override for a new environment" >&2
fi
email_alias_parameter="/mcc/prod/match-to-csv/email-alias"
if [[ -n "${email_alias_override:-}" ]]; then
  export TF_VAR_email_alias="$email_alias_override"
elif email_alias="$(aws ssm get-parameter --name "$email_alias_parameter" --region "$region" \
  --query Parameter.Value --output text 2>/dev/null)"; then
  export TF_VAR_email_alias="$email_alias"
else
  echo "Cannot read $email_alias_parameter with profile $AWS_PROFILE; TF_VAR_email_alias is unset. Run aws sso login, or set email_alias_override for the apply that creates it" >&2
fi
